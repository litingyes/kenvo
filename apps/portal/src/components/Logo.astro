---
interface Props {
  class?: string;
}

const { class: className = 'h-8 w-8' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="2" />
  <path
    d="M50 0 A50 50 0 0 1 50 100 A25 25 0 0 1 50 50 A25 25 0 0 0 50 0 Z"
    fill="#22d3ee"
  />
  <path
    d="M50 0 A50 50 0 0 0 50 100 A25 25 0 0 0 50 50 A25 25 0 0 1 50 0 Z"
    fill="#fbbf24"
  />
  <circle cx="50" cy="25" r="8" fill="#fbbf24" />
  <circle cx="50" cy="75" r="8" fill="#22d3ee" />
</svg>
