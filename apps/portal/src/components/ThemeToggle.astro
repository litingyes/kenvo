---
interface Props {
  labels: {
    light: string;
    dark: string;
    system: string;
  };
}

const { labels } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-light-label={labels.light}
  data-dark-label={labels.dark}
  data-system-label={labels.system}
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-background text-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
  aria-label={labels.system}
>
  <span data-mode="light" class="hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </span>
  <span data-mode="dark" class="hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
  <span data-mode="system" class="hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="20" height="14" x="2" y="3" rx="2"></rect>
      <line x1="8" x2="16" y1="21" y2="21"></line>
      <line x1="12" x2="12" y1="17" y2="21"></line>
    </svg>
  </span>
</button>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'kenvo-portal-theme';
    const modes = ['light', 'dark', 'system'];

    const apply = (mode) => {
      const isDark =
        mode === 'dark' ||
        (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.setAttribute('data-theme', 'kenvo');
    };

    const updateUI = (mode) => {
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        const label =
          btn.getAttribute('data-' + mode + '-label') ||
          btn.getAttribute('aria-label');
        btn.setAttribute('aria-label', label);
        btn.querySelectorAll('[data-mode]').forEach((el) => {
          el.classList.toggle('hidden', el.getAttribute('data-mode') !== mode);
        });
      });
    };

    const init = () => {
      const saved = localStorage.getItem(STORAGE_KEY) || 'system';
      updateUI(saved);

      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const current = localStorage.getItem(STORAGE_KEY) || 'system';
          const next = modes[(modes.indexOf(current) + 1) % modes.length];
          localStorage.setItem(STORAGE_KEY, next);
          apply(next);
          updateUI(next);
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
