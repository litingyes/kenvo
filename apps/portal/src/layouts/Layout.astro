---
import '../styles/global.css';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang={locale} data-theme="kenvo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>

    <script is:inline>
      (function () {
        const key = 'kenvo-portal-theme';
        const saved = localStorage.getItem(key) || 'system';
        const apply = (mode) => {
          const isDark =
            mode === 'dark' ||
            (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.setAttribute('data-theme', 'kenvo');
        };
        apply(saved);
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', () => {
            if ((localStorage.getItem(key) || 'system') === 'system') apply('system');
          });
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
