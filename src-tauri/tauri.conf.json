{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kenvo",
  "version": "0.0.0",
  "identifier": "app.vercel.kenvo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:31420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kenvo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/locales/*": "resources/locales/"
    }
  }
}
